<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:orientation="vertical"

    tools:context=".MainActivity"
    android:background="#E7F2F1"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="10dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:id="@+id/scroll"

        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="16dp"
        tools:context=".DoctorDetailActivity">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"

            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:scaleType="centerCrop"
                android:id="@+id/back_img"
                android:clipToOutline="true"
                app:layout_constraintStart_toStartOf="parent"
                app:shapeAppearanceOverlay="@style/Circular"
                android:src="@drawable/back_icon2"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"


                />
            <TextView
                android:layout_width="wrap_content"
                android:textColor="#000000"
                android:id="@+id/profile_name"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/back_img"
                app:layout_constraintEnd_toStartOf="@id/end_img"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:textStyle="bold"

                android:text="Doctor Details"/>

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:id="@+id/end_img"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:shapeAppearanceOverlay="@style/Circular"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"

                android:src="@drawable/bell_icon"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/doctor_avatar_detail"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/doctor_avatar"
            app:shapeAppearanceOverlay="@style/Circular"/>

        <TextView
            android:id="@+id/doctor_name_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="Dr._ _ _ _ " />

        <TextView
            android:id="@+id/specialty_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#000000"
            android:textSize="18sp"
            tools:text="_ _ _ _ _ " />
<LinearLayout
    android:layout_marginBottom="40dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/reviews_click"
    android:gravity="center"
    android:orientation="horizontal">
    <TextView
    android:id="@+id/rating_detail"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:textColor="#000000"

    android:textSize="16sp"
    tools:text="Rating:" />
    <TextView
        android:id="@+id/rating_click"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#000000"

        android:textSize="16sp"
        tools:text="5" />
    <TextView
        android:id="@+id/rating_detail3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#000000"

        android:textSize="16sp"
        tools:text="Reviews:" />
    <TextView
        android:id="@+id/reviews_click2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#000000"

        android:textSize="16sp"
        tools:text="50" />

</LinearLayout>

        <TextView
            android:layout_margin="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:text="About"
            />
        <TextView
            android:id="@+id/about_doctor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:text="Dr Murad is a board-certified cardiologist with over 12 years of experience in the field of cardiovascular medicine.He specilizes. More"
            />
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/rupee"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_margin="10dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:background="@drawable/white_rounded_box"
                android:orientation="vertical"
                android:padding="10dp">



                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_marginEnd="5dp"
                        android:background="#000000"
                        android:scaleType="centerCrop"
                        android:src="@drawable/rupee_icon"
                        app:shapeAppearanceOverlay="@style/Circular" />

                    <TextView
                        android:id="@+id/murad_text1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Session Fee"
                        android:textColor="#000000" />

                <TextView
                    android:id="@+id/murad_specialty2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="@font/open_sans"
                    android:gravity="right"
                    android:text="Rs 500"

                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!--                review code starts here -->


            </LinearLayout>

            <LinearLayout
                android:id="@+id/doctor_murad1"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_margin="10dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:background="@drawable/white_rounded_box"
                android:orientation="vertical"
                android:padding="10dp">



                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="5dp"
                    android:background="#000000"
                    android:scaleType="centerCrop"
                    android:src="@drawable/rupee_icon"
                    app:shapeAppearanceOverlay="@style/Circular" />

                <TextView
                    android:id="@+id/murad_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Session Fee"
                    android:textColor="#000000" />

                <TextView
                    android:id="@+id/murad_specialty1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="@font/open_sans"
                    android:gravity="right"
                    android:text="Rs 500"

                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!--                review code starts here -->


            </LinearLayout>

        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/rupee2"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_margin="10dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:background="@drawable/white_rounded_box"
                android:orientation="vertical"
                android:padding="10dp">



                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="5dp"
                    android:background="#000000"
                    android:scaleType="centerCrop"
                    android:src="@drawable/time_icon"
                    app:shapeAppearanceOverlay="@style/Circular" />

                <TextView
                    android:id="@+id/murad_text2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Session Time"
                    android:textColor="#000000" />

                <TextView
                    android:id="@+id/murad_specialty3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="@font/open_sans"
                    android:gravity="right"
                    android:text="9am to 5 pm"

                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!--                review code starts here -->


            </LinearLayout>

            <LinearLayout
                android:id="@+id/doctor_murad"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_margin="10dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:background="@drawable/white_rounded_box"
                android:orientation="vertical"
                android:padding="10dp">



                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="5dp"
                    android:background="#000000"
                    android:scaleType="centerCrop"
                    android:src="@drawable/people_icon"
                    app:shapeAppearanceOverlay="@style/Circular" />

                <TextView
                    android:id="@+id/murad_text3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Session Type"
                    android:textColor="#000000" />

                <TextView
                    android:id="@+id/murad_specialty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="@font/open_sans"
                    android:gravity="right"
                    android:text="_____"

                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!--                review code starts here -->


            </LinearLayout>

        </LinearLayout>

        <!--                review code endds here -->

            </LinearLayout>


<!--&lt;!&ndash;&ndash;&gt;scroll view ends here-->
        </LinearLayout>

    </ScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_margin="10dp"

        android:layout_width="match_parent"
        android:background="@drawable/red_rounded_box"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:padding="15dp"
        android:layout_gravity="center"
        android:id="@+id/logout_cons"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:gravity="center"
            android:id="@+id/book_appointment"
            android:textColor="#000000"
            android:layout_height="wrap_content"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"


            android:text="Book Appointment"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

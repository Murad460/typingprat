<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/card_container"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center_horizontal"
        app:cardElevation="3dp"
        app:cardCornerRadius="20dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/child_treatment"
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:background="@drawable/white_rounded_box"
            android:orientation="vertical"
            android:padding="5dp"
            >

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_marginStart="10dp"

                android:orientation="horizontal">


                <TextView
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/edit_icon"
                    app:layout_constraintHorizontal_bias="0.0"
                    android:id="@+id/child_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/white_rounded_box"
                    android:gravity="center"
                    android:padding="2dp"
                    android:textStyle="bold"
                    android:text="Asif Ahmed"
                    android:textColor="#000000"
                    android:textSize="14sp" />
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/edit_icon"
                    app:layout_constraintEnd_toStartOf="@id/Delete_icon"
                    android:layout_width="40dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_height="40dp"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/edit_profile"
                    app:shapeAppearanceOverlay="@style/Circular" />
                <com.google.android.material.imageview.ShapeableImageView
                    app:layout_constraintEnd_toEndOf="parent"
                    android:id="@+id/Delete_icon"
                    android:layout_width="40dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_height="40dp"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/delete_icon"
                    app:shapeAppearanceOverlay="@style/Circular" />
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginStart="10dp"
                android:orientation="horizontal">
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/calender_icon"
                    android:layout_width="25dp"

                    android:layout_height="25dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/calender_icon"
                    app:shapeAppearanceOverlay="@style/Circular" />

                <TextView
                    android:id="@+id/child_age"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/open_sans"
                    android:gravity="center"
                    android:lineHeight="0.5dp"
                    android:text="10 years old"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    />
            </LinearLayout>

            <LinearLayout
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"

                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_total2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="@font/open_sans"
                    android:gravity="start"
                    android:lineHeight="0.5dp"
                    android:text="Session Type:"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/child_session"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="@font/open_sans"
                    android:gravity="start"
                    android:lineHeight="0.5dp"
                    android:text="Allergy"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    />
                <TextView
                    android:id="@+id/tv_total5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="@font/open_sans"
                    android:gravity="start"
                    android:lineHeight="0.5dp"
                    android:text="Therapist Name:"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/name_therapist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="@font/open_sans"
                    android:gravity="start"
                    android:lineHeight="0.5dp"
                    android:text="Occupational Therapy"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    />


            </LinearLayout>





            <LinearLayout
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"

                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_total13"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="@font/open_sans"
                    android:gravity="start"
                    android:lineHeight="0.5dp"
                    android:text="Treatment Goal:"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/treatment_goal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="@font/open_sans"
                    android:gravity="start"
                    android:lineHeight="0.5dp"
                    android:text="Allergy"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    />
                <TextView
                    android:id="@+id/tv_total157"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="@font/open_sans"
                    android:gravity="start"
                    android:lineHeight="0.5dp"
                    android:text="Planned Activities:"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/planned_activities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="@font/open_sans"
                    android:gravity="start"
                    android:lineHeight="0.5dp"
                    android:text="Occupational Therapy"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    />
                <TextView
                    android:id="@+id/tv_total15"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="@font/open_sans"
                    android:gravity="start"
                    android:lineHeight="0.5dp"
                    android:text="Progress Note:"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/progress_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="@font/open_sans"
                    android:gravity="start"
                    android:lineHeight="0.5dp"
                    android:text="Occupational Therapy"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    />


                <TextView
                    android:id="@+id/treatment_plan_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="@font/open_sans"
                    android:gravity="start"
                    android:lineHeight="0.5dp"
                    android:text="Plan: Loading..."
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>


        </LinearLayout>


    </androidx.cardview.widget.CardView>

</LinearLayout>